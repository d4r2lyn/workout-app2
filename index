function SimpleChecklist({ rows, checkedState, onToggle, idPrefix, accentColor }) {
  return (
    <div>
      {rows.map(([a, b], i) => {
        const key = `${idPrefix}-${i}`;
        const done = checkedState[key] || false;
        return (
          <div key={i} style={{
            display: "flex", alignItems: "center", gap: "0.6rem",
            padding: "0.4rem 0.4rem",
            borderBottom: `1px solid ${C.cardBorder}22`,
            opacity: done ? 0.5 : 1,
          }}>
            <Checkbox checked={done} onchange={() => onToggle(key)} accentColor={accentColor} />
            <span style="font-weight: 500; color: C.textDark; font-size: 0.85rem; flex: 1; text-decoration: done ? "line-through" : "none">{a}</span>
            <span style="color: C.textMuted; font-size: 0.82rem">{b}</span>
          </div>
        );
      })}
    </div>
  );
}

function CollapsibleSection({ title, emoji, color, bg, defaultOpen, count, doneCount, children }) {
  const [open, setOpen] = useState(defaultOpen !== undefined ? defaultOpen : true);
  const hasCounts = count !== undefined;
  const allDone = hasCounts && doneCount === count;
  return (
    <div style={{ background: bg || C.cardBg, border: `1px solid ${C.cardBorder}`, borderRadius: 12, marginBottom: "0.6rem", overflow: "hidden" }}>
      <div onclick={() => setOpen(!open)} style="padding: 0.65rem 1rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none">
        <div style="display: flex; align-items: center; gap: 0.5rem">
          <span style="font-size: 1.1rem; transition: transform 0.2s; transform: open ? "rotate(90deg)" : "rotate(0); color: color || C.olive">▶</span>
          <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: color || C.olive">{emoji} {title}</span>
        </div>
        {hasCounts && (
          <span style={{ fontSize: "0.7rem", fontWeight: 700, padding: "0.15rem 0.55rem", borderRadius: 999, background: allDone ? C.sage : `${color}22`, color: allDone ? "white" : (color || C.textMuted) }}>
            {allDone ? "✅" : `${doneCount}/${count}`}
          </span>
        )}
      </div>
      {open && <div style="padding: 0 1rem 0.75rem">{children}</div>}
    </div>
  );
}

function DayCard({ day, checkedState, onToggle }) {
  // Count completed per section
  const countDone = (prefix, arr) => arr.filter((_, i) => checkedState[`${prefix}-${i}`]).length;
  const warmupDone = countDone(`d${day.id}-warmup`, day.warmup);
  const workoutDone = countDone(`d${day.id}-workout`, day.exercises);
  const extraDone = day.extraSection ? countDone(`d${day.id}-extra`, day.extraSection.exercises) : 0;
  const cooldownDone = countDone(`d${day.id}-cooldown`, day.cooldown);
  const totalExercises = day.exercises.length + (day.extraSection ? day.extraSection.exercises.length : 0);
  const totalDoneExercises = workoutDone + extraDone;

  const allKeys = [];
  day.warmup.forEach((_, i) => allKeys.push(`d${day.id}-warmup-${i}`));
  day.exercises.forEach((_, i) => allKeys.push(`d${day.id}-workout-${i}`));
  if (day.extraSection) day.extraSection.exercises.forEach((_, i) => allKeys.push(`d${day.id}-extra-${i}`));
  day.cooldown.forEach((_, i) => allKeys.push(`d${day.id}-cooldown-${i}`));
  const total = allKeys.length;
  const done = allKeys.filter(k => checkedState[k]).length;
  const pct = total > 0 ? Math.round((done / total) * 100) : 0;

  return (
    <div style={{ background: C.cardBg, border: `1px solid ${C.cardBorder}`, borderRadius: 14, marginBottom: "1.25rem", overflow: "hidden", boxShadow: "0 1px 4px #0001" }}>
      <!-- Day header -->
      <div style={{
        background: day.headerBg, padding: "0.9rem 1.25rem",
        fontWeight: 700, fontSize: "1.02rem",
        display: "flex", justifyContent: "space-between", alignItems: "center",
        color: C.textDark, flexWrap: "wrap", gap: "0.5rem",
        borderBottom: `2px solid ${day.borderAccent}44`,
      }}>
        <span>{day.emoji} {day.title}</span>
        <div style="display: flex; align-items: center; gap: 0.6rem">
          <span style={{ fontSize: "0.72rem", fontWeight: 700, padding: "0.2rem 0.6rem", borderRadius: 999, background: pct === 100 ? C.sage : `${day.borderAccent}22`, color: pct === 100 ? "white" : day.color }}>
            {pct === 100 ? "✅ All Done!" : `${done}/${total}`}
          </span>
          <span style={{ fontSize: "0.7rem", fontWeight: 600, padding: "0.2rem 0.6rem", borderRadius: 999, background: day.tagBg, color: day.color, textTransform: "uppercase", letterSpacing: "0.5px", border: `1px solid ${day.color}33` }}>{day.tag}</span>
        </div>
      </div>

      <!-- Progress bar -->
      <div style="height: 4; background: C.cream; overflow: hidden">
        <div style={{ height: "100%", width: `${pct}%`, background: `linear-gradient(90deg, ${day.color}, ${C.sage})`, transition: "width 0.3s" }} />
      </div>

      <div style="padding: 0.75rem 0.75rem 0.5rem">
        <!-- WARM-UP — collapsible -->
        <CollapsibleSection
          title={day.warmupLabel || "Warm-Up (5–10 min)"}
          emoji="🔥"
          color={C.terracotta}
          bg={C.terracottaBg + "66"}
          defaultOpen={false}
          count={day.warmup.length}
          doneCount={warmupDone}
        >
          <SimpleChecklist rows={day.warmup} checkedState={checkedState} onToggle={onToggle} idPrefix={`d${day.id}-warmup`} accentColor={day.color} />
        </CollapsibleSection>

        <!-- WORKOUT — collapsible, open by default -->
        <CollapsibleSection
          title="Workout"
          emoji="💪"
          color={day.color}
          bg={day.headerBg + "88"}
          defaultOpen={true}
          count={totalExercises}
          doneCount={totalDoneExercises}
        >
          <ExerciseTable exercises={day.exercises} accentColor={day.color} checkedState={checkedState} onToggle={onToggle} idPrefix={`d${day.id}-workout`} />
          {day.extraSection && (
            <>
              <p style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: C.olive; margin: 0.75rem 0 0.4rem">{day.extraSection.label}</p>
              <ExerciseTable exercises={day.extraSection.exercises} accentColor={day.color} checkedState={checkedState} onToggle={onToggle} idPrefix={`d${day.id}-extra`} />
            </>
          )}
        </CollapsibleSection>

        <!-- COOL-DOWN — collapsible -->
        <CollapsibleSection
          title="Cool-Down (5–8 min)"
          emoji="🧘"
          color={C.pastelMint}
          bg={C.pastelMintBg + "88"}
          defaultOpen={false}
          count={day.cooldown.length}
          doneCount={cooldownDone}
        >
          <SimpleChecklist rows={day.cooldown} checkedState={checkedState} onToggle={onToggle} idPrefix={`d${day.id}-cooldown`} accentColor={day.color} />
        </CollapsibleSection>
      </div>
    </div>
  );
}

