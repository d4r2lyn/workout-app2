function Checkbox({ checked, onChange, accentColor }) {
  return (
    <div onclick={onChange} style={{
      width: 20, height: 20, minWidth: 20, borderRadius: 5,
      border: checked ? "none" : `2px solid ${C.cardBorder}`,
      background: checked ? (accentColor || C.sage) : "transparent",
      display: "flex", alignItems: "center", justifyContent: "center",
      cursor: "pointer", transition: "all 0.15s",
    }}>
      {checked && <span style="color: white; font-size: 0.7rem; font-weight: 700">✓</span>}
    </div>
  );
}

function ExerciseTable({ exercises, accentColor, checkedState, onToggle, idPrefix }) {
  return (
    <div>
      {exercises.map(([name, sets, notes], i) => {
        const key = `${idPrefix}-${i}`;
        const done = checkedState[key] || false;
        return (
          <div key={i} style={{
            display: "flex", alignItems: "flex-start", gap: "0.6rem",
            padding: "0.55rem 0.4rem",
            borderBottom: `1px solid ${C.cardBorder}33`,
            opacity: done ? 0.5 : 1,
            transition: "opacity 0.2s",
            background: i % 2 === 0 ? "transparent" : `${C.cream}66`,
