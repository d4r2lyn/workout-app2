              <p style="font-weight: 700; color: C.sage; margin-bottom: 0.4rem">💧 Daily Water Goal: 80–100 oz</p>
              <p style="font-size: 0.84rem; color: C.textMuted; line-height: 1.5">That's about 5–6 regular water bottles throughout the day. On workout days, aim for the higher end. Try keeping a bottle with you at all times and sipping consistently rather than chugging all at once! Add lemon, cucumber, or mint to make it more fun 🍋</p>
            </div>
          </div>
        )}

        <!-- ═══ PROGRESSION TAB ═══ -->
        {activeTab === "progress" && (
          <div>
            {PROGRESSION.map(({ emoji, title, text }, i) => (
              <div key={i} style={{ background: C.cardBg, border: `1px solid ${C.cardBorder}`, borderRadius: 14, padding: "1.25rem 1.5rem", marginBottom: "0.75rem", boxShadow: "0 1px 4px #0001" }}>
                <p style="color: C.sand; font-weight: 700; margin-bottom: 0.4rem; font-size: 1rem">{emoji} {title}</p>
                <p style="font-size: 0.88rem; color: C.textMuted; line-height: 1.6">{text}</p>
              </div>
            ))}
            <div style={{ background: C.sageBg, border: `1.5px solid ${C.sage}55`, borderRadius: 14, padding: "1.25rem 1.5rem", marginTop: "1rem" }}>
              <p style="color: C.sageDark; font-weight: 700; margin-bottom: 0.5rem; font-size: 1rem">🔑 The Key: Progressive Overload</p>
              <p style="font-size: 0.88rem; color: C.textMuted; line-height: 1.6">Every 2–3 weeks, make things a little harder — add 1–2 reps, add a set, shorten rest time, or increase weight. Your body adapts, so you have to keep challenging it! 🌱➡️🌳</p>
            </div>
          </div>
        )}

        <!-- ═══ TIPS TAB ═══ -->
        {activeTab === "tips" && (
          <div style="display: grid; grid-template-columns: repeat(auto-fit; gap: 1rem">
            {TIPS.map(({ title, text, icon }, i) => {
              const colors = [C.sage, C.pastelMint, C.sand, C.terracotta];
              const bgs = [C.sageBg, C.pastelMintBg, C.sandBg, C.terracottaBg];
              return (
                <div key={i} style={{ background: bgs[i], border: `1px solid ${C.cardBorder}`, borderRadius: 12, padding: "1.1rem 1.25rem" }}>
                  <p style="font-size: 1rem; margin-bottom: 0.4rem; color: colors[i]; font-weight: 700">{icon} {title}</p>
                  <p style="font-size: 0.85rem; color: C.textMuted; line-height: 1.55">{text}</p>
                </div>
              );
            })}
          </div>
        )}

        <!-- Footer -->
        <div style={{ textAlign: "center", color: C.textDim, fontSize: "0.8rem", marginTop: "2.5rem", paddingTop: "1.25rem", borderTop: `1px solid ${C.cardBorder}` }}>
          <p>🌿 Built for Monarq — May 2026 🌿</p>
          <p style="margin-top: 0.25rem">Consistency beats intensity every time. You've got this! 💪🍑✨</p>
        </div>
      </div>
    </div>
  );
}
